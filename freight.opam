opam-version: "2.0"
synopsis: "Neovim HTTP client plugin core library"
description:
  "Core OCaml library for parsing, executing, and rendering HTTP requests for freight.ml"
maintainer: ["aktersnurra"]
authors: ["aktersnurra"]
license: "LICENSE"
tags: ["neovim" "http" "ocaml"]
homepage: "https://github.com/aktersnurra/freight.ml"
doc: "https://github.com/aktersnurra/freight.ml"
bug-reports: "https://github.com/aktersnurra/freight.ml/issues"
depends: [
  "ocaml"
  "dune" {>= "3.21"}
  "angstrom"
  "yojson"
  "re"
  "msgpck"
  "eio"
  "eio_main"
  "eio_posix"
  "ounit2" {with-test}
  "qcheck-core" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/aktersnurra/freight.ml.git"
x-maintenance-intent: ["(latest)"]
